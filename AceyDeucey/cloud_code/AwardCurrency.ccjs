// AwardCurrency.ccjs
//
// Awards vcAmount units of the "bucks" virtual currency to the calling
// player. Called by the client via scriptService.runScript whenever a
// hand is won (see lib/main.dart awardCurrency()).
//
// Portal setup required (one-time):
//   1. Design > Marketplace > Virtual Currencies > create a currency with ID "bucks".
//   2. Design > Cloud Code > Scripts > Upload AwardCurrency.ccjs
//        - clientCallable: true
//        - s2sCallable:    false
//        - scriptTimeout:  20
//
// Request (scriptData):
//   { "vcAmount": <int> }
//
// Response:
//   0 (always — this sample script does not check the award result)

"use strict";

function main () {
  var vcId = 'bucks'
  var vcAmount = data.vcAmount
  var virtualCurrencyProxy = bridge.getVirtualCurrencyServiceProxy()

  var postResult = virtualCurrencyProxy.awardCurrency(vcId, vcAmount)

  return 0
}

main()
